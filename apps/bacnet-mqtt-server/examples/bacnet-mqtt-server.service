[Unit]
Description=BACnet MQTT Server - Dynamic BACnet server fed by MQTT + JSON
Documentation=https://github.com/bacnet-stack/bacnet-stack
After=network.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=bacnet
Group=bacnet
ExecStart=/usr/local/bin/bacnet-mqtt-server --config /etc/bacnet-mqtt-server/config.yaml --foreground
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Hardening options
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/bacnet-mqtt-server
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW

# Environment
Environment="BACNET_IFACE="
Environment="BACNET_IP_PORT=47808"

[Install]
WantedBy=multi-user.target
